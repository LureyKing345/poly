# --- copy this file to server/.env and fill in real values ---

# Port for the demo backend HTTP API (and static React serving).
PORT=4317

# Optional: shared bearer token. When set, /api/* requires
#   Authorization: Bearer <API_TOKEN>
# Leave empty for an open demo (single-tenant on a private network only).
API_TOKEN=

# Where to persist demo state. Default = server/state.json next to index.js.
# STATE_PATH=/var/lib/polymarket/state.json

# Polymarket Gamma API URL override (rarely needed).
# GAMMA_API_URL=https://gamma-api.polymarket.com/markets?active=true&closed=false&limit=40&order=volume24hr&ascending=false&tag=crypto

# --- Telegram bot ---
# Create a bot with @BotFather on Telegram, copy the token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed chat IDs (yours, your friends').
# Find your chat id by messaging @userinfobot on Telegram.
# If empty, the bot accepts every chat — only do that on private servers.
TELEGRAM_ALLOWED_CHAT_IDS=
